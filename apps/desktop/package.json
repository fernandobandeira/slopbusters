{
  "name": "@slopbusters/desktop",
  "productName": "Slopbusters",
  "version": "0.1.14",
  "private": true,
  "description": "Slopbusters desktop code review workspace.",
  "author": "Fernando Bandeira",
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "pnpm build && pnpm start",
    "build": "pnpm --dir ../reviewer build && node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "pack": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "test": "node scripts/smoke.mjs",
    "smoke": "pnpm build && pnpm test",
    "test:updates": "node --test scripts/updates.test.cjs"
  },
  "devDependencies": {
    "electron": "44.4.2",
    "electron-builder": "26.15.6",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "dev.slopbusters.reviewer",
    "productName": "Slopbusters",
    "directories": { "output": "release" },
    "files": ["dist/**", "!dist/workspaceTypeScriptWorker.cjs", "!dist/typescript/**", "package.json"],
    "extraResources": [
      { "from": "dist/workspaceTypeScriptWorker.cjs", "to": "source-analysis/workspaceTypeScriptWorker.cjs" },
      { "from": "dist/typescript", "to": "source-analysis/typescript", "filter": ["*.d.ts"] }
    ],
    "asar": true,
    "mac": {
      "icon": "dist/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": { "icon": "dist/icon.png", "target": ["nsis"] },
    "linux": { "icon": "dist/icon.png", "category": "Development", "target": ["AppImage"] },
    "publish": {
      "provider": "github",
      "owner": "fernandobandeira",
      "repo": "slopbusters"
    },
    "artifactName": "Slopbusters-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
