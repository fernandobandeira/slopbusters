    "node": "^24.0.0 || >=26.0.0",
    "pnpm": "9.15.5"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@pierre/diffs": "^1.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "class-variance-authority": "^0.7.1",
    "diff": "^9.0.0",
    "express": "^5.2.1",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "4.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vscode-jsonrpc": "8.2.1",
    "zod": "^4.6.5"
