{
  "name": "@slopbusters/reviewer",
  "version": "0.1.0",
  "private": true,
  "description": "The local Slopbusters workspace for reviewing pull requests.",
  "scripts": {
    "dev": "concurrently -k -n api,web 'tsx watch server/index.ts' 'vite --host 127.0.0.1'",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "keywords": [],
