{
  "name": "@slopbusters/reviewer",
  "version": "0.1.0",
  "private": true,
  "description": "The local Slopbusters workspace for reviewing pull requests.",
  "scripts": {
    "dev": "concurrently -k -n api,web 'tsx watch server/index.ts' 'vite --host 127.0.0.1'",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "lint": "pnpm typecheck && pnpm format:check && pnpm lint:code && pnpm architecture && pnpm unused",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint:code": "NODE_OPTIONS=--max-old-space-size=6144 eslint . --max-warnings 0",
    "lint:prune": "NODE_OPTIONS=--max-old-space-size=6144 eslint . --prune-suppressions && prettier --write eslint-suppressions.json",
    "architecture": "depcruise src server shared --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-baseline.json",
    "architecture:prune": "depcruise src server shared --config .dependency-cruiser.cjs --baseline .dependency-cruiser-baseline.json --baseline-mode shrink-only && prettier --write .dependency-cruiser-baseline.json",
    "unused": "knip --config knip.json"
  },
  "keywords": [],
  "author": "Fernando Bandeira",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "^24.0.0 || >=26.0.0",
    "pnpm": "10.34.6"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@pierre/diffs": "~1.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "class-variance-authority": "^0.7.1",
    "diff": "^9.0.0",
    "effect": "4.0.0-rc.115",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "4.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vscode-jsonrpc": "10.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@t3code/t3-darwin-arm64": "0.0.45"
  }
}
